PORT=3001
DATABASE_URL=

LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# ── Embedding (Phase 4 — Ollama + BGE-M3, fully local, no API key required) ──
# Install model once: ollama pull bge-m3
# Start service:      systemctl start ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434

# EMBEDDING_API_KEY is NOT required for Ollama.
# Leave blank or omit entirely. Only needed for future paid providers (e.g., OpenAI).
EMBEDDING_API_KEY=

STT_API_KEY=
STT_PROVIDER=

TTS_API_KEY=
TTS_PROVIDER=
