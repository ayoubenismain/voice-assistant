PORT=3001
DATABASE_URL=

# ── LLM Generation Provider ──────────────────────────────────────────────────
# Set LLM_PROVIDER to choose the active generation backend:
#   ollama  — local Ollama (default, development/local)
#   gemini  — Google Gemini API (cloud/lightweight)
LLM_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────────────────────
# Install model once: ollama pull qwen3:4b-instruct
# Start service:      systemctl start ollama
LLM_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=120000
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Gemini (cloud) ──────────────────────────────────────────────────────────
# Only required when LLM_PROVIDER=gemini
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Lighter fallback model used after all primary retries are exhausted (transient errors only)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Retries on primary model before trying fallback.
# 0 = no retry: primary attempt → fallback attempt (recommended for interactive use)
# The fallback gets a full attempt-budget slot when retries are 0.
GEMINI_MAX_RETRIES=0
# Per-attempt hard timeout — each Gemini call is aborted after this many ms
GEMINI_ATTEMPT_TIMEOUT_MS=15000
# Total wall-clock budget for the entire generate call (retries + backoff + fallback)
GEMINI_TOTAL_TIMEOUT_MS=40000

# ── RAG Context ──────────────────────────────────────────────────────────────
RAG_RETRIEVAL_TOP_K=8
RAG_CONTEXT_MAX_CHUNKS=6
RAG_CONTEXT_MAX_CHARS=12000

# ── Embedding (Phase 4 — Ollama + BGE-M3, fully local, no API key required) ──
# Install model once: ollama pull bge-m3
# Start service:      systemctl start ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# EMBEDDING_API_KEY is NOT required for Ollama.
# Leave blank or omit entirely. Only needed for future paid providers (e.g., OpenAI).
EMBEDDING_API_KEY=

# ── Phase 8A: Speech-to-Text ────────────────────────────────────────────────
# Only "gemini" is supported in Phase 8A.
# Reuses GEMINI_API_KEY above — do NOT add a second STT_API_KEY secret.
STT_PROVIDER=gemini
# Gemini transcription model
STT_MODEL=gemini-3.5-transcribe
# Hard wall-clock timeout per transcription call (ms)
STT_TIMEOUT_MS=15000
# Comma-separated vocabulary to bias ASR toward ISSATSO-specific terms.
# Multi-word phrases (e.g. "cycle préparatoire") are supported.
STT_CUSTOM_VOCABULARY=ISSATSO,PFE,rattrapage,Licence,Master,cycle préparatoire,cycle ingénieur,inscription,Sousse,stage,CIVP

TTS_API_KEY=
TTS_PROVIDER=

# ── Phase 8B: Voice endpoint ─────────────────────────────────────────────────
# Maximum uploaded push-to-talk audio size (5 MB)
VOICE_MAX_AUDIO_BYTES=5242880
