# Copy to .env and fill in. NEVER commit .env.

# --- ISSATSO+ authentication (manually supplied, short-lived) ---
ISSATSO_BEARER_TOKEN=

# --- Source ---
ISSATSO_BASE_URL=https://issatso.rnu.tn
DISCOVERY_CLASS=LSI-A3-02
# Optional: direct workbook URL used only if metadata discovery fails
FALLBACK_WORKBOOK_URL=
EXCEL_SHEET_NAME=E-02EditionParGroupeS1ouS2

# --- Personal timetable (used by /api/v1/me/...) ---
STUDENT_CLASS=LSI-A3-02
STUDENT_SUBGROUP=LSI-A3-02-1

# --- Security: required to use POST /api/v1/sync/run (header X-Admin-Secret). Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=
HOST=127.0.0.1
PORT=8000
# Comma separated origins allowed by CORS; leave empty to disable CORS
CORS_ORIGINS=

# --- Database ---
DATABASE_URL=sqlite:///./data/timetable.db

# --- Scheduler (timezone Africa/Tunis) ---
SCHEDULER_ENABLED=true
SYNC_WEEKDAY=mon
SYNC_HOUR=8
SYNC_MINUTE=0
SYNC_ON_STARTUP=false
TIMEZONE=Africa/Tunis
